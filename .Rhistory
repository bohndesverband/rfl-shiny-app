shape = ""
) +
ggplot2::theme(
panel.grid.minor = ggplot2::element_blank(),
legend.position = "top",
legend.direction = "horizontal",
legend.spacing.x = grid::unit(50, "pt"),
legend.key.width = grid::unit(15, "pt")
)
ggiraph::girafe(ggobj = plot, width_svg = 16, height_svg = 9) %>%
ggiraph::girafe_options(
ggiraph::opts_hover(css = paste0("fill:", color_red, ";stroke:", color_bg)),
ggiraph::opts_hover_inv(css = "opacity:0.2")
)
plot <- ggplot2::ggplot(data, ggplot2::aes(x = Adrian, y = Jakob)) +
ggplot2::annotate(
"polygon",
x = c(-Inf, Inf, Inf),
y = c(-Inf, Inf, -Inf),
fill = color_blue,
alpha = 0.1
) +
ggplot2::annotate(
"text",
label = "Besser bewertet von Adrian",
x = 1.1,
y = 6.4,
hjust = 0,
vjust = 0,
lineheight = 0.9,
) +
ggplot2::annotate(
"polygon",
x = c(-Inf, -Inf, Inf),
y = c(-Inf, Inf, Inf),
fill = color_cyan,
alpha = 0.1
) +
ggplot2::annotate(
"text",
label = "Besser bewertet von Jakob",
x = 6.7,
y = 1,
hjust = 1,
vjust = 0,
lineheight = 0.9,
) +
ggplot2::geom_abline(color = color_bg, linewidth = 2) +
ggrepel::geom_label_repel(
data = subset(data, year == 2026 & !grepl("trade", pick)),
ggplot2::aes(label = asset_name_output)
) +
ggiraph::geom_point_interactive(
data = subset(data, pick != "klasse"),
ggplot2::aes(
tooltip = paste(asset_name_output, "\nBewertung: ", year, "\nAdrian: ", Adrian, "\nJakob: ", Jakob),
data_id = pick,
color = diff,
size = year,
alpha = year,
shape = shape
),
stroke = 2
) +
ggiraph::geom_point_interactive(
data = subset(data, pick == "klasse"),
ggplot2::aes(
tooltip = paste(asset_name_output, "\nBewertung: ", year, "\nAdrian: ", Adrian, "\nJakob: ", Jakob),
data_id = pick,
size = year,
color = diff,
alpha = year,
shape = shape
),
stroke = 2
) +
ggplot2::scale_shape_manual(
values = c("pick" = 16, "laterounds" = 17, "trade" = 18, "klasse" = 1),
labels = c("pick" = "Draftpick", "laterounds" = "Late Round Picks", "trade" = "Trade", "klasse" = "Draftklasse")
) +
ggplot2::scale_alpha_continuous(range = c(0.4, 0.8), guide = "none") +
ggplot2::scale_color_continuous(palette = c(color_blue, color_cyan), limits = c(6.6, -6.6), guide = "none") +
ggplot2::scale_fill_continuous(palette = c(color_blue, color_cyan), limits = c(6.6, -6.6), guide = "none") +
ggplot2::scale_size_continuous(range = c(4, 10), guide = "none") +
ggplot2::scale_x_continuous(
limits = c(6.7, 0),
breaks = seq(6, 1, by = -1),
minor_breaks = seq(6.666, 1, by = -0.333)
) +
ggplot2::scale_y_continuous(
limits = c(6.7, 0),
breaks = seq(6, 2, by = -1),
minor_breaks = seq(6.666, 1, by = -0.333)
) +
plot_defaults +
ggplot2::labs(
title = "Alle Bewertungen der Draftklasse",
subtitle = "Jeder Punkt ist ein Asset in der Draftklasse, das bewertet wurde.\nJe größer der Punkt, desto aktueller ist die Bewertung.",
x = "Bewertung von Adrian",
y = "Bewertung von Jakob",
shape = ""
) +
ggplot2::theme(
panel.grid.minor = ggplot2::element_blank(),
legend.position = "top",
legend.direction = "horizontal",
legend.spacing.y = grid::unit(50, "pt"),
legend.key.width = grid::unit(15, "pt")
)
ggiraph::girafe(ggobj = plot, width_svg = 16, height_svg = 9) %>%
ggiraph::girafe_options(
ggiraph::opts_hover(css = paste0("fill:", color_red, ";stroke:", color_bg)),
ggiraph::opts_hover_inv(css = "opacity:0.2")
)
